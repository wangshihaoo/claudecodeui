# Frontend Vite configuration
# Only includes variables that are actually used in the code

# Frontend port
VITE_PORT=5173

# Host/IP to bind the Vite server to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Set to true for the hosted-platform UI variant
# VITE_IS_PLATFORM=false
